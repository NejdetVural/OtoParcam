# Copy this file to `.env` (already gitignored, matched by the `*.env` rule) and fill in real
# values before running `docker compose up`. See CLAUDE.md's Secrets section for the equivalent
# local-dev (non-Docker) setup via `dotnet user-secrets`.

# SQL Server "sa" password. Must satisfy SQL Server's complexity policy: 8+ characters, with
# at least three of upper/lower/digit/symbol.
MSSQL_SA_PASSWORD=Ch4ngeMe!2026

# 32+ random characters — same requirement as the local `dotnet user-secrets set "Jwt:Secret" ...`
# value. Generate one however you like, e.g.: openssl rand -base64 32
JWT_SECRET=replace-with-32-plus-random-characters

# Optional — leave blank to skip real email sending (register/reset links are still logged to the
# backend container's stdout). See CLAUDE.md's Email section for the Gmail app-password setup.
EMAIL_FROM_ADDRESS=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
